{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/web-of-thoughts/run.schema.json",
  "title": "Web of Thoughts experiment run",
  "type": "object",
  "required": ["spec_version", "run_id", "task_id", "method", "model", "budget", "result"],
  "properties": {
    "spec_version": { "type": "string" },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "method": { "enum": ["direct", "cot", "self_consistency", "tot", "got", "wot"] },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "model": {
      "type": "object",
      "required": ["provider", "name"],
      "properties": {
        "provider": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "temperature": { "type": "number" },
        "seed": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    },
    "budget": {
      "type": "object",
      "required": ["max_calls", "max_total_tokens"],
      "properties": {
        "max_calls": { "type": "integer", "minimum": 1 },
        "max_total_tokens": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "max_wall_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "verification_reserve_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "properties": {
        "dimensions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "operators": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "scheduler_version": { "type": "string" },
        "prompt_hashes": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "properties": {
        "calls": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "wall_seconds": { "type": "number", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "nodes_created": { "type": "integer", "minimum": 0 },
        "edges_created": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["status", "termination_reason"],
      "properties": {
        "status": { "enum": ["success", "failure", "invalid", "partial"] },
        "termination_reason": { "enum": ["bypassed", "converged", "verified_threshold", "dominated_alternatives", "low_marginal_value", "budget_exhausted", "error"] },
        "primary_score": { "type": ["number", "null"] },
        "answer_path": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

