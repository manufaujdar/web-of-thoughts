# Required for live runs. Never commit the real value.
OPENAI_API_KEY=replace-with-a-server-side-key

# Current recommended quality-first default resolved from official guidance.
WOT_MODEL=gpt-5.6-sol
WOT_REASONING_EFFORT=medium

# Local single-node persistence and safety limits.
WOT_DATABASE_PATH=data/wot.db
WOT_MAX_AGENTS=8
WOT_MAX_ROUNDS=2
WOT_MAX_CONCURRENCY=4
WOT_MAX_CALLS=20
WOT_MAX_WALL_SECONDS=300
WOT_AGENT_OUTPUT_TOKENS=700
WOT_MASTER_OUTPUT_TOKENS=1600
WOT_RETENTION_DAYS=30
WOT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
